# Сразу перевыпусти ранее опубликованный токен через @BotFather и вставь НОВЫЙ.
TELEGRAM_BOT_TOKEN=replace_with_new_token
TELEGRAM_ADMIN_ID=0
TELEGRAM_SOURCE_CHANNEL=destiny_place
TELEGRAM_SOURCE_CHANNELS=destiny_place,ikarushop,asphyxia_store

SCAN_INTERVAL_MINUTES=1
MAX_NEW_DRAFTS_PER_SCAN=6
SOURCE_PAGE_LIMIT=30
REQUEST_TIMEOUT_SECONDS=30
DATA_DIR=./data

# Цена CNY × 13 × 1.15 + доставка + наценка.
YUAN_RATE=13
PROCUREMENT_MULTIPLIER=1.15
COMPETITOR_CHEAPER_RUB=500
COMPETITOR_LOW_PRICE_THRESHOLD_RUB=3000
COMPETITOR_LOW_DISCOUNT_MIN_RUB=200
COMPETITOR_LOW_DISCOUNT_MAX_RUB=300
ASPHYXIA_MARKUP_RUB=1000
DISCOUNT_MIN_PERCENT=25
DISCOUNT_MAX_PERCENT=70

# AI необязателен: без ключа используются локальные правила.
USE_AI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Taobao Open Platform / Taobao Alliance.
TAOBAO_BROWSER_ENABLED=false
TAOBAO_BROWSER_PROFILE=
TAOBAO_BROWSER_HEADLESS=false
TAOBAO_BROWSER_TIMEOUT_SECONDS=45
TAOBAO_LOGIN_TIMEOUT_MINUTES=10
TAOBAO_KEYWORDS_PER_SCAN=2
TAOBAO_SEARCH_DELAY_SECONDS=9
TAOBAO_DETAIL_CANDIDATES_PER_SCAN=8
TAOBAO_MIN_CLEAN_IMAGES=3
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
TAOBAO_SESSION=
TAOBAO_API_URL=https://eco.taobao.com/router/rest

# Pinduoduo Open Platform / Duoduo Ke.
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=
PDD_API_URL=https://gw-api.pinduoduo.com/api/router

# Можно задать через запятую; config/keywords.txt имеет приоритет.
SEARCH_KEYWORDS=
SEARCH_KEYWORDS_FILE=./config/keywords.txt
